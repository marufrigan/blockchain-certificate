# Database
# Homebrew Postgres on Mac usually uses your macOS username, not "postgres":
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/trustcert
DATABASE_SSL=false

# JWT
JWT_SECRET=change-this-to-a-long-random-secret

# Blockchain (Polygon Amoy testnet)
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
NETWORK_NAME=amoy
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Pinata IPFS — REQUIRED for real "View on IPFS" links. Create keys at https://pinata.cloud
# Leave both empty for local dev: chain + DB still work; file link is hidden (no fake 404).
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# App URLs
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000

# Hardhat (root .env used by contracts/)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://rpc.sepolia.org
